APP_NAME=MarsOtomasyon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=marsotomasyon
DB_USERNAME=mars
DB_PASSWORD=
DB_SSLMODE=prefer
DB_TIMEZONE=UTC

# Valkey is Redis-protocol compatible; Laravel uses its native Redis/PhpRedis driver.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=mars:
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_QUEUE=mars-default
REDIS_QUEUE_RETRY_AFTER=90

CACHE_STORE=redis
CACHE_PREFIX=mars-cache:
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# M23 production-candidate controls. Production must override backup disk/target/key values.
MARS_DEPLOYMENT_MODEL=docker-compose
MARS_PRIMARY_FILE_DISK=local
MARS_RECOVERY_MODE=false
MARS_RECOVERY_STATE_STORE=redis
MARS_RECOVERY_STATE_KEY=mars:production:recovery-mode
MARS_OUTBOUND_PROVIDERS_ENABLED=true
MARS_ASYNC_WORK_ENABLED=true
MARS_SCHEDULER_WORK_ENABLED=true
MARS_RECOVERY_RETRY_AFTER_SECONDS=300
MARS_DISABLED_PROVIDERS=
MARS_BACKUP_DISK=local
MARS_BACKUP_OFFSITE_REQUIRED=true
MARS_BACKUP_OFFSITE_TARGET=
# S3-compatible offsite backup storage. Production should set MARS_BACKUP_DISK=mars_backup.
MARS_BACKUP_S3_ACCESS_KEY_ID=
MARS_BACKUP_S3_SECRET_ACCESS_KEY=
MARS_BACKUP_S3_REGION=us-east-1
MARS_BACKUP_S3_BUCKET=
MARS_BACKUP_S3_ENDPOINT=
MARS_BACKUP_S3_PATH_STYLE=false
# Generate a dedicated 32-byte key (for example base64:...) and never reuse APP_KEY.
MARS_BACKUP_RECOVERY_KEY=
# Non-secret identifier for key rotation/audit, e.g. vault://mars/backup/recovery/v1.
MARS_BACKUP_RECOVERY_KEY_REFERENCE=
# Production must set this false after legacy APP_KEY-encrypted artifacts are migrated/retired.
MARS_BACKUP_ALLOW_LEGACY_APP_KEY_DECRYPTION=true
MARS_BACKUP_RPO_HOURS=24
MARS_BACKUP_RTO_HOURS=4
MARS_RESTORE_DRILL_MAX_AGE_DAYS=30
MARS_BACKUP_RETENTION_DAILY=14
MARS_BACKUP_RETENTION_WEEKLY=8
MARS_BACKUP_RETENTION_MONTHLY=12

VITE_APP_NAME="${APP_NAME}"
