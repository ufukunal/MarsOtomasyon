APP_NAME=MarsOtomasyon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mars.example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=marsotomasyon
DB_USERNAME=mars
DB_PASSWORD=
DB_SSLMODE=prefer
DB_TIMEZONE=UTC

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=mars:
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_QUEUE=mars-default
REDIS_QUEUE_RETRY_AFTER=90
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=MarsOtomasyon

MARS_DEPLOYMENT_MODEL=docker-compose
MARS_PRIMARY_FILE_DISK=local
MARS_RECOVERY_MODE=false
MARS_RECOVERY_STATE_STORE=redis
MARS_RECOVERY_STATE_KEY=mars:production:recovery-mode
MARS_OUTBOUND_PROVIDERS_ENABLED=true
MARS_ASYNC_WORK_ENABLED=true
MARS_SCHEDULER_WORK_ENABLED=true
MARS_RECOVERY_RETRY_AFTER_SECONDS=300
MARS_DISABLED_PROVIDERS=

MARS_BACKUP_DISK=mars_backup
MARS_BACKUP_OFFSITE_REQUIRED=true
MARS_BACKUP_OFFSITE_TARGET=s3://mars-backup-prod
MARS_BACKUP_S3_ACCESS_KEY_ID=
MARS_BACKUP_S3_SECRET_ACCESS_KEY=
MARS_BACKUP_S3_REGION=us-east-1
MARS_BACKUP_S3_BUCKET=
MARS_BACKUP_S3_ENDPOINT=
MARS_BACKUP_S3_PATH_STYLE=false
MARS_BACKUP_RECOVERY_KEY=
MARS_BACKUP_RECOVERY_KEY_REFERENCE=vault://mars/backup/recovery/v1
MARS_BACKUP_ALLOW_LEGACY_APP_KEY_DECRYPTION=false
MARS_BACKUP_RPO_HOURS=24
MARS_BACKUP_RTO_HOURS=4
MARS_RESTORE_DRILL_MAX_AGE_DAYS=30
MARS_BACKUP_RETENTION_DAILY=14
MARS_BACKUP_RETENTION_WEEKLY=8
MARS_BACKUP_RETENTION_MONTHLY=12

MARS_HTTP_PORT=8080
VITE_APP_NAME=MarsOtomasyon
