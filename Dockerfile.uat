# Disposable Laravel UAT runtime. Not a production PHP-FPM/reverse proxy setup.
# There are deliberately NO PostgreSQL or Valkey server containers.
FROM node:22-bookworm-slim AS assets
WORKDIR /src
COPY . .
RUN npm ci --ignore-scripts --no-audit --no-fund && npm run build

FROM php:8.4-cli-bookworm AS app
ENV APP_ENV=local APP_DEBUG=false
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip postgresql-client \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev libicu-dev \
    libonig-dev libpq-dev libzip-dev libxml2-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath exif gd intl mbstring opcache pcntl pdo_pgsql pgsql zip \
    && pecl install redis && docker-php-ext-enable redis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html
COPY . .
# Composer invokes Laravel package:discover, which requires writable
# framework/cache and framework/views paths *during* dependency installation.
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/testing \
       storage/framework/views storage/logs storage/app/private storage/app/attachments \
       storage/app/report-exports bootstrap/cache \
    && composer install --no-dev --no-interaction --prefer-dist --no-progress --optimize-autoloader \
    && chown -R www-data:www-data storage bootstrap/cache
COPY --from=assets /src/public/build /var/www/html/public/build
USER www-data
EXPOSE 8080
CMD ["php","artisan","serve","--host=0.0.0.0","--port=8080"]
