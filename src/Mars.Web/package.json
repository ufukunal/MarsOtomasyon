{
  "name": "@mars/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "verify:static": "node scripts/verify-foundation.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:static"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
