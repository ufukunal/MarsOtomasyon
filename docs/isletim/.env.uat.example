# MarsProject isolated UAT only. Copy to /etc/mars/uat.env with mode 0600.
# Never commit real values to the repository, logs or Docker images.
# Set YES only after the dedicated DBs and Valkey ACL have been verified.
MARS_UAT_ISOLATION_CONFIRMED=NO
APP_NAME=MarsUAT
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:18080
APP_TIMEZONE=Europe/Istanbul
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=master
DB_HOST=mars-prod-1.taila20365.ts.net
DB_PORT=55432
DB_MASTER_DATABASE=mars_test_master
DB_USERNAME=mars_test
DB_PASSWORD=
DB_SSLMODE=prefer
REDIS_CLIENT=phpredis
REDIS_HOST=mars-prod-1.taila20365.ts.net
REDIS_PORT=6379
REDIS_USERNAME=mars_test
REDIS_PASSWORD=
REDIS_PREFIX=mars:test:
REDIS_DB=1
REDIS_CACHE_DB=1
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
MAIL_MAILER=log
FILESYSTEM_DISK=local
ATTACHMENTS_DISK_DRIVER=local
PRINTING_DRIVER=browser
