[Unit]
Description=Mars scheduler worker
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mars/current
EnvironmentFile=/etc/mars/mars.env
ExecStart=/usr/bin/php /var/www/mars/current/artisan schedule:work
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
