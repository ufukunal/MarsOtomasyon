[Unit]
Description=Mars privileged operations queue worker
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=simple
User=mars-ops
Group=mars-ops
WorkingDirectory=/var/www/mars/current
EnvironmentFile=/etc/mars/mars-operations.env
ExecStart=/usr/bin/php /var/www/mars/current/artisan queue:work redis --queue=operations --sleep=3 --tries=1 --timeout=7200 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=7200
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
